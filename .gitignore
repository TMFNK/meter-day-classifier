# env / caches (re-creatable)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# secrets — NEVER commit
.env
.env.*

# model weights in any format (never commit retrains by accident)
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.ckpt

# OS / editor
.DS_Store
.vscode/
.idea/

# Private human data (see data/README.md) — never commit.
/data/labels_v1.json
/data/raw/
outputs/label_pack/selection.json

# NOTE: synth/ (generated training data), artifacts/ (the frozen model),
# and outputs/ (scoreboard + per-day predictions) ARE committed on purpose.
# They are the worked example: regenerate the data with
# generate_synth_meters.py to verify byte-identical output (see README).
# Regenerating synth/ must never touch artifacts/ — they are separate
# folders so a data rerun cannot silently overwrite the shipped model.

# Cline / agent scratch
.cline/
.cursor/
cursorbot
cline.json
clinebot/
.claude/
.codex/
.opencode/
